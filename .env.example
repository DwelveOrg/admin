# Dwelve operator console.
#
# Copy to `.env.local` for development. Never commit a real SESSION_SECRET.

# The same NestJS backend the product frontend talks to. Server-side only —
# this never reaches the browser, and no request from the browser goes to it
# directly, so the backend's CORS allowlist does not need this app's origin.
#
#   local     http://localhost:5001/api/v1
#   production https://dwelve-rjwkt.ondigitalocean.app/api/v1
DWELVE_API_BASE_URL="http://localhost:5001/api/v1"

# Encrypts the operator session cookie (JWE, dir + A256GCM).
#
# MUST NOT be the frontend's SESSION_SECRET. They are different trust domains:
# sharing the key would mean a student's session cookie decrypts here, and an
# operator's decrypts there. Generate a fresh one:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-me-with-32-random-bytes"

# Optional. The host report screenshots are served from, when it is not the
# default DigitalOcean Spaces CDN. Must match the backend's
# PUBLIC_UPLOAD_BASE_URL host.
# NEXT_PUBLIC_MEDIA_HOST="dwelvespaces.sgp1.cdn.digitaloceanspaces.com"
